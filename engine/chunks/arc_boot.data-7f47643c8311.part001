    <script>
        const hcMiddleware = document.createElement('script');
        hcMiddleware.onerror = function(){
           HCInterface.onHelpcenterError();
        };
        hcMiddleware.src = "%cdn";
        document.body.appendChild(hcMiddleware);
    </script>
